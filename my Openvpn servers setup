Step 6: Generate TLS authentication key (optional but recommended)
openvpn --genkey --secret ta.key

Place ta.key in the OpenVPN config folder /etc/openvpn/


root@openvpnsvr001:~/openvpn-ca# openvpn --genkey --secret ta.key
2026-03-13 05:25:38 DEPRECATED OPTION: The option --secret is deprecated.
2026-03-13 05:25:38 WARNING: Using --genkey --secret filename is DEPRECATED.  Use --genkey secret filename instead.
root@openvpnsvr001:~/openvpn-ca#


 sudo nano /etc/openvpn/server/server.conf

port 1194
proto udp
dev tun

ca /home/ubuntu/openvpn-ca/pki/ca.crt
cert /home/ubuntu/openvpn-ca/pki/issued/server.crt
key /home/ubuntu/openvpn-ca/pki/private/server.key
dh /home/ubuntu/openvpn-ca/pki/dh.pem
tls-auth /etc/openvpn/ta.key 0

server 10.8.0.0 255.255.255.0
ifconfig-pool-persist ipp.txt

push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 8.8.8.8"
push "dhcp-option DNS 8.8.4.4"

keepalive 10 120
cipher AES-256-CBC
auth SHA256
persist-key
persist-tun

status openvpn-status.log
verb 3

Step 2: Enable IP forwarding
sudo nano /etc/sysctl.conf

Ensure this line exists and is uncommented:

net.ipv4.ip_forward=1

